#!/bin/bash
# octboot — host bootloader for the Cavium CN6640 SNIC10E. Boots the card with NO
# SERIAL: SBR the card, restore its BARs, push the OpenWrt image into card DRAM over
# PCIe BAR2, let u-boot boot it, then wait for the card NIC heartbeat.
# It is the host bootloader, not just a helper script. Needs the one-time
# persisted u-boot env:
#   bootdelay=1
#   wa/wb/wc/wd  = program the PEM BAR1 window (+ flush_l2c/flush_dcache to activate it)
#   wg           = wait (u-boot while/itest) until the host writes "GO!!" at DRAM 0x20000100
#   bootcmd      = clear flag ; run wa wb wc wd ; run wg ; flush_l2c ; flush_dcache ; bootoctlinux 0x20010000 ...
#
# Host-only flow (no console): SBR reboots the card -> u-boot runs bootcmd -> programs its
# own window -> waits for the host flag. The host restores its BARs, waits for BAR2 to become
# writable (window live), pushes the OpenWrt image into card DRAM via BAR2 + wordfix, sets the
# flag, then u-boot flushes and boots the freshly-pushed image immediately.
set -u
SELF="$(dirname "$(readlink -f "$0")")"
# Card image: honour $IMG, else search. Repo root first — that is where a user drops the
# image downloaded from a release, and it must win over a stale OpenWrt build tree.
if [ -z "${IMG:-}" ]; then
  for c in \
    "$SELF"/*snic10e-initramfs-kernel.bin \
    "$SELF"/openwrt/bin/targets/octeon/generic/*snic10e-initramfs-kernel.bin \
    /home/*/openwrt/bin/targets/octeon/generic/*snic10e-initramfs-kernel.bin ; do
    [ -f "$c" ] && IMG="$c" && break
  done
fi
IMG=${IMG:-}
[ -n "$IMG" ] && [ -f "$IMG" ] || { echo "[FAIL] card image not found (set IMG=... or build: ./openwrt/build-openwrt.sh)"; exit 1; }
OFF=${OFF:-0x10000}
[ "$(id -u)" = 0 ] || exec sudo IMG="$IMG" "$0" "$@"

ok(){ printf '[ \033[32mOK\033[0m ] %s\n' "$1"; }

# host_window [wait_s]: program the card's PEM BAR1 window (P2N_BAR0/1 + BAR1_INDEX0..7) from the
# HOST, through the SLI indirect window in BAR0 -- the same registers u-boot's wa..wd write. Needed
# when the card's SLI is alive but BAR2 is not (u-boot never ran/finished wa..wd, or a PCIe reset
# wiped the window): without it BAR2 stays 0xffffffff and the push can never start. SAFETY: the
# SLI window's timeout (SLI_WINDOW_CTL, BAR0+0x2E0) defaults to 0 = wait forever, and a window op
# to a dead target hard-freezes the host, so the timeout is written FIRST and read back; if it
# does not stick (SLI not really up) nothing else is touched. Only CSRs are accessed through the
# window (never card DRAM: window->DRAM reads are what froze the host before). Returns 0 once BAR2
# accepts a write, 1 otherwise.
host_window() {
  CARD=$CARD WAIT=${1:-0} python3 - <<'PY'
import mmap,os,struct,sys,time
c=os.environ["CARD"]; d="/sys/bus/pci/devices/0000:%s/"%c
res=open(d+"resource").read().split("\n")
b0=int(res[0].split()[0],16); b2=int(res[2].split()[0],16)
if not b0 or not b2: sys.exit(1)
f=os.open(d+"resource0",os.O_RDWR); m=mmap.mmap(f,16384,mmap.MAP_SHARED)
r=lambda o: struct.unpack("<I",m[o:o+4])[0]
def w(o,v): m[o:o+4]=struct.pack("<I",v)
t=time.time()
while r(0x3d80)==0xffffffff:                     # SLI_S2M_PORT0_CTL: all-ones = SLI not up
    if time.time()-t>=float(os.environ["WAIT"]): sys.exit(1)
    time.sleep(0.2)
w(0x2e0,0x200000)                                # SLI_WINDOW_CTL timeout, before ANY window op
if r(0x2e0)!=0x200000: sys.exit(1)
def rd(a):
    w(0x14,((a>>32)&0xffffffff)|0x00060000); r(0x14); w(0x10,a&0xffffffff); r(0x10)
    return struct.unpack("<Q",m[0x40:0x48])[0]
def wr(a,v):
    w(0x4,a>>32); w(0x0,a&0xffffffff); w(0x30,0xff)
    w(0x24,v>>32); r(0x24); w(0x20,v&0xffffffff)  # low word last: it triggers the write
PEM=0x00011800C0000000
rbase=0x20000000>>22                             # 4 MB granule of the card-DRAM load base
wr(PEM+0x80,b0); wr(PEM+0x88,b2)
for i in range(8): wr(PEM+0xA8+8*i,((rbase+i)<<4)|0xB)
if rd(PEM+0x80)!=b0 or rd(PEM+0x88)!=b2: sys.exit(1)   # readback: window regs took the values
fd=os.open(d+"resource2",os.O_RDWR); n=mmap.mmap(fd,64*1024*1024,mmap.MAP_SHARED)
n[0x10000:0x10008]=b"NSRLIVE0"; n.flush()
sys.exit(0 if bytes(n[0x10000:0x10008])==b"NSRLIVE0" else 1)
PY
}

# soft_reset_chip: restart the Octeon (CIU_SOFT_RST) through the SLI window. This is what revives a
# card whose cores already ran bootoctlinux on an empty load address (u-boot's pre-boot wait expired
# while the host was still in BIOS POST and the window had been wiped by a PCIe reset): neither SBR
# nor a cold power-up recovers it, but a chip soft reset restarts u-boot and with it the wait, giving
# the host a fresh window to push the image. Same SLI_WINDOW_CTL safety rule as host_window.
soft_reset_chip() {
  CARD=$CARD python3 - <<'PY'
import mmap,os,struct,sys
d="/sys/bus/pci/devices/0000:%s/"%os.environ["CARD"]
f=os.open(d+"resource0",os.O_RDWR); m=mmap.mmap(f,16384,mmap.MAP_SHARED)
r=lambda o: struct.unpack("<I",m[o:o+4])[0]
def w(o,v): m[o:o+4]=struct.pack("<I",v)
if r(0x3d80)==0xffffffff: sys.exit(1)           # SLI not up: nothing to reset through
w(0x2e0,0x200000)
if r(0x2e0)!=0x200000: sys.exit(1)
w(0x4,0x00010700); w(0x0,0x00000740); w(0x30,0xff)  # CIU_SOFT_RST = 0x0001070000000740
w(0x24,0); r(0x24); w(0x20,1)
PY
}

# pci_console_boot: boot the card with NO serial and NO working u-boot env. After a chip soft reset,
# u-boot may sit at its prompt (lost/empty env, or its autoboot aborted) and its UART RX can be
# wired back to its own TX, so u-boot reads its own prompt as typed input and a serial console is
# useless. u-boot's PCI console (a ring in card DRAM, found at the bootmem block "__pci_console")
# IS read at the prompt, so we type through it: program the PEM window from the host, slow the card
# UART to ~95 baud (the looped-back echo then trickles at ~10 chars/s while the host drains it, so a
# typed line is not interleaved with junk), push the image, then type
#   flush_l2c; flush_dcache; bootoctlinux 0x20010000 numcores=8 endbootargs ...
# Returns 0 when the command was consumed (caller then waits for the heartbeat).
pci_console_boot() {
  CARD=$CARD IMG=$IMG RGO=${RGO:-3} python3 - <<'PY'
import mmap,os,struct,sys,time
c=os.environ["CARD"]; d="/sys/bus/pci/devices/0000:%s/"%c
res=open(d+"resource").read().split("\n")
b0=int(res[0].split()[0],16); b2=int(res[2].split()[0],16)
f=os.open(d+"resource0",os.O_RDWR); m=mmap.mmap(f,16384,mmap.MAP_SHARED)
r=lambda o: struct.unpack("<I",m[o:o+4])[0]
def w(o,v): m[o:o+4]=struct.pack("<I",v)
t0=time.time()
while r(0x3d80)==0xffffffff:
    if time.time()-t0>15: sys.exit(1)
    time.sleep(0.02)
w(0x2e0,0x200000)                                    # SLI_WINDOW_CTL timeout first (host-freeze guard)
if r(0x2e0)!=0x200000: sys.exit(1)
def rd(a):
    w(0x14,((a>>32)&0xffffffff)|0x00060000); r(0x14); w(0x10,a&0xffffffff); r(0x10)
    return struct.unpack("<Q",m[0x40:0x48])[0]
def wr(a,v):
    w(0x4,a>>32); w(0x0,a&0xffffffff); w(0x30,0xff)
    w(0x24,v>>32); r(0x24); w(0x20,v&0xffffffff)
PEM=0x00011800C0000000; U=0x0001180000000800
wr(PEM+0x80,b0); wr(PEM+0x88,b2)
wr(PEM+0xA8,(0x3f<<4)|0xB)                           # BAR2+0   -> card 0x0fc00000 (PCI console block)
for i in range(1,16): wr(PEM+0xA8+8*i,((0x80+i-1)<<4)|0xB)   # BAR2+4M.. -> card 0x20000000..
fd=os.open(d+"resource2",os.O_RDWR); n=mmap.mmap(fd,64*1024*1024,mmap.MAP_SHARED)
be=lambda o: struct.unpack(">I",bytes(n[o:o+4]))[0]
CON=0x0fffcea0-0x0fc00000; INB=0x0fffcec8-0x0fc00000
def drain(ms):
    t=time.time()
    while time.time()-t<ms/1000:
        if rd(U+0x28)&1: rd(U)
# wait for u-boot to be up at its prompt: PCI console descriptor valid, then a settle time
ok=False
while time.time()-t0<40:
    drain(200)
    if be(0x0fffce80-0x0fc00000)==1 and time.time()-t0>=16: ok=True; break
if not ok: sys.exit(2)
wr(U+0x18,0x93); wr(U+0x00,0xff); wr(U+0x08,0xff); wr(U+0x18,0x13)   # UART divisor 0xffff (~95 baud)
drain(400)
def send(s):
    for ch in s.encode():
        wp=be(CON+0xc); n[INB+wp]=ch; n[CON+0xc:CON+0x10]=struct.pack(">I",(wp+1)%0x400)
    t=time.time()
    while be(CON+8)!=be(CON+0xc) and time.time()-t<4: drain(2)
    return be(CON+8)==be(CON+0xc)
img=open(os.environ["IMG"],"rb").read(); off=0x400000+0x10000    # card DRAM 0x20010000
n[off:off+len(img)]=img; n.flush()
for it in range(10):
    rb=bytes(n[off:off+len(img)])
    bad=[] if rb==img else [i for i in range(0,len(img),4) if img[i:i+4]!=rb[i:i+4]]
    if not bad: print("[ \033[32mOK\033[0m ] Uploading OpenWrt... (%d bytes, %d fix passes)"%(len(img),it)); break
    for i in bad: n[off+i:off+i+4]=img[i:i+4]
    n.flush()
else: sys.exit(3)
drain(300)
line="\x03flush_l2c\rflush_dcache\rbootoctlinux 0x20010000 numcores=8 endbootargs console=ttyS0,115200 octeon-ethernet.receive_group_order=%s\r"%os.environ["RGO"]
sys.exit(0 if send(line) else 4)
PY
}

CARD=$(lspci -d 177d:0092 | awk '{print $1}' | head -1)
[ -n "$CARD" ] || { echo "[FAIL] CN6640 (177d:0092) not found"; exit 1; }
BRIDGE=$(basename "$(dirname "$(readlink -f /sys/bus/pci/devices/0000:$CARD)")" | sed 's/^0000://')
ok "CN6640 detected ($CARD, bridge $BRIDGE)"

# Fast path: the card is already sitting in u-boot with a live BAR2 window (cold boot — u-boot
# programmed the window and is in its long pre-boot sleep). Push straight in: no SBR, no race.
# SBR only if the card runs OpenWrt (reload) or the window is not live (at prompt / wedged).
# No driver binds the card (liquidio blacklisted), so the kernel leaves COMMAND=0 (memory decode
# off) and every BAR2 read is 0xffffffff even with a live window -> looked "dead", cost an SBR.
setpci -s "$CARD" COMMAND=0x06
STATE=$(CARD=$CARD python3 - <<'PY'
import mmap,os
try:
    fd=os.open("/sys/bus/pci/devices/0000:%s/resource2"%os.environ["CARD"],os.O_RDWR)
    m=mmap.mmap(fd,64*1024*1024,mmap.MAP_SHARED)
    import sys; print("[dbg] bar2[0]=0x%08x bar2[0x10000]=0x%08x"%(int.from_bytes(bytes(m[0:4]),"little"),int.from_bytes(bytes(m[0x10000:0x10004]),"little")),file=sys.stderr)
    if int.from_bytes(bytes(m[0:4]),"little")==0x4f435348:
        print("osready" if int.from_bytes(bytes(m[8:12]),"little") else "os")   # OpenWrt up -> SBR to reload (or reuse at boot)
    else:
        m[0x10000:0x10008]=b"NSRLIVE0"; m.flush()
        print("live" if bytes(m[0x10000:0x10008])==b"NSRLIVE0" else "dead")
    m.close(); os.close(fd)
except Exception:
    print("dead")
PY
)
DOSBR=1; SOFTRST=0; PCIBOOT=0; PUSHRC=0
# Boot-time reuse (cavium-up sets OCT_REUSE=1 right after host boot): a card whose OS is already
# up and ready (host warm reboot / card kept power) is usable as is -> skip SBR + reload, ~30 s.
if [ "$STATE" = osready ] && [ "${OCT_REUSE:-0}" = 1 ]; then
  ok "Card OS already up and ready -- reusing it (no reload)"; exit 0
fi
echo "[dbg] state=$STATE cmd=$(setpci -s "$CARD" COMMAND) bar0=$(setpci -s "$CARD" BASE_ADDRESS_0) bar2=$(setpci -s "$CARD" BASE_ADDRESS_2)"
if [ "$STATE" = live ]; then
  ok "Window already live (u-boot waiting) -- direct push, no SBR"; DOSBR=0
elif [ "$STATE" = dead ]; then
  # Not a live window and not running OS -- but this can just be a card mid-boot, NOT a wedge.
  # Killer case: host firmware double-boots on cold power (a warm reset ~40s in). The card stays
  # powered across the host warm reset, so it keeps counting its u-boot sleep and bootoctlinux's
  # on its own -- but this second octboot run catches it mid-Linux-boot (window down, magic not
  # up yet) and used to SBR it, wedging it mid-jump (magic 0xffffffff, only a power cycle
  # recovers). So wait for the NIC heartbeat first; SBR only if it never comes.
  ok "Window not live -- waiting up to 10s for a mid-boot card to surface (avoid SBR-wedge)"
  for _ in $(seq 1 10); do
    up=$(CARD=$CARD python3 - <<'PY'
import mmap,os
try:
    fd=os.open("/sys/bus/pci/devices/0000:%s/resource2"%os.environ["CARD"],os.O_RDWR)
    m=mmap.mmap(fd,4096,mmap.MAP_SHARED)
    print(1 if int.from_bytes(bytes(m[0:4]),"little")==0x4f435348 and int.from_bytes(bytes(m[8:12]),"little") else 0)
    m.close(); os.close(fd)
except Exception: print(0)
PY
)
    [ "$up" = 1 ] && { ok "Card came up on its own (prior push) -- no SBR, no reload"; exit 0; }
    sleep 1
  done
  # A host-programmed window here would NOT prove u-boot is still waiting (its wait may have
  # expired into a jump to garbage), so restart the chip instead (soft reset, else SBR below).
  ok "Still not up after 10s -- assume wedged, restarting the card"
fi   # STATE=os falls through with DOSBR=1 (OpenWrt running -> SBR to reload a fresh image)
if [ "$DOSBR" = 1 ]; then
  if [ "$STATE" = dead ]; then
    # BARs may be zeroed (an earlier SBR/PCIe reset): restore from sysfs so SLI (BAR0) is reachable
    RES0=/sys/bus/pci/devices/0000:$CARD/resource
    setpci -s "$CARD" BASE_ADDRESS_0=$(printf '0x%08x' $(( ($(awk 'NR==1{print $1}' "$RES0")) & 0xffffffff | 0xc ))) \
                      BASE_ADDRESS_1=0x00000000 \
                      BASE_ADDRESS_2=$(printf '0x%08x' $(( ($(awk 'NR==3{print $1}' "$RES0")) & 0xffffffff | 0xc ))) \
                      BASE_ADDRESS_3=0x00000000 COMMAND=0x06
  fi
  if [ "$STATE" = dead ] && soft_reset_chip; then
    ok "Chip soft reset (CIU_SOFT_RST via SLI window) -- u-boot restarts, fresh pre-boot wait"
    SOFTRST=1; sleep 1
  else
    setpci -s "$BRIDGE" BRIDGE_CONTROL=40:40; sleep 0.2; setpci -s "$BRIDGE" BRIDGE_CONTROL=00:40
    ok "Secondary Bus Reset"
  fi
  sleep 2					# window wait below polls; no fixed u-boot delay needed
fi

if [ "$DOSBR" = 1 ]; then
  # SBR zeroed the card BARs. Restore them to the addresses the kernel/BIOS assigned, read LIVE
  # from sysfs -- do NOT hardcode. A reseat / re-enumeration moves them (this card went
  # f4000000 -> c4000000 after a reseat), and a stale hardcode points the card's decode at an
  # address the bridge doesn't forward and the host doesn't mmap => BAR2 "never writable" and a
  # working window gets broken. Low nibble 0x0c = 64-bit prefetchable memory (both BARs).
  RES=/sys/bus/pci/devices/0000:$CARD/resource
  B0=$(( ($(awk 'NR==1{print $1}' "$RES")) & 0xffffffff | 0xc ))
  B2=$(( ($(awk 'NR==3{print $1}' "$RES")) & 0xffffffff | 0xc ))
  setpci -s "$CARD" BASE_ADDRESS_0=$(printf '0x%08x' $B0) BASE_ADDRESS_1=0x00000000 \
                    BASE_ADDRESS_2=$(printf '0x%08x' $B2) BASE_ADDRESS_3=0x00000000 COMMAND=0x06
  ok "BAR restored (BAR0=$(printf '0x%08x' $B0) BAR2=$(printf '0x%08x' $B2))"
else
  # Fast path: window already live, BARs are the BIOS-assigned ones and the card is decoding.
  # Rewriting them here (esp. with a stale hardcode) only risks breaking a working window.
  ok "BARs left as enumerated (window already live)"
fi

# Match the card's PCIe MaxPayload to the bridge (256B). SBR reset it to 128B, which
# fragments every DMA into more TLPs. Set DevCtl.MPS[7:5]=001 (read-modify: OR 0x20).
DEVCTL=$(setpci -s "$CARD" CAP_EXP+8.w 2>/dev/null)
if [ -n "$DEVCTL" ]; then
  NEW=$(printf '%04x' $(( 0x$DEVCTL & ~0x00e0 | 0x0020 )))
  setpci -s "$CARD" CAP_EXP+8.w=$NEW 2>/dev/null && ok "MPS 256B (DevCtl $DEVCTL->$NEW)"
fi

# After a soft reset, drive u-boot through its PCI console (no serial, works with an empty env and
# with the UART RX looped back); if that fails, fall back to the u-boot-env handshake below.
if [ "$SOFTRST" = 1 ]; then
  ok "Driving u-boot through its PCI console (takes ~25 s before the image push)"
  if pci_console_boot; then PCIBOOT=1; ok "Boot command typed into u-boot (PCI console)"
  else echo "[WARN] PCI-console boot failed (rc=$?), falling back to the env handshake"; fi
fi
if [ "$PCIBOOT" != 1 ]; then
# After an SBR u-boot normally re-programs the window itself; if it has not done so by the time
# SLI is back, do it from the host (no-op when it already did: same values).
[ "$DOSBR" = 1 ] && host_window 8 && ok "BAR2 window programmed from the host (SLI window)"
OFF=$OFF CARD=$CARD python3 - "$IMG" <<'PY'
import mmap,os,sys,time
off=int(os.environ["OFF"],0); card=os.environ["CARD"]
d=open(sys.argv[1],'rb').read()
fd=os.open("/sys/bus/pci/devices/0000:%s/resource2"%card,os.O_RDWR)
m=mmap.mmap(fd,64*1024*1024,mmap.MAP_SHARED)
# wait until BAR2 is writable (u-boot has programmed the window) via a marker round-trip
mark=b"NSRLIVE0"; live=False
for _ in range(120):                         # up to 60s: after an SBR u-boot can take >20s
    m[off:off+8]=mark; m.flush()             # (DRAM training) before it programs the window
    if bytes(m[off:off+8])==mark: live=True; print("[ \033[32mOK\033[0m ] Window live (%s tries)"%(_+1)); break
    time.sleep(0.5)
if not live:
    print("[FAIL] BAR2 never writable; card not at bootcmd/window?"); sys.exit(1)
# push image + wordfix (WC-write corruption correction)
m[off:off+len(d)]=d; m.flush()
for it in range(10):
    rb=bytes(m[off:off+len(d)])
    # whole-buffer compare first (C speed); only walk the words when something differs
    bad=[] if rb==d else [i for i in range(0,len(d),4) if d[i:i+4]!=rb[i:i+4]]
    if not bad: print("[ \033[32mOK\033[0m ] Uploading OpenWrt... (%d bytes, %d fix passes)"%(len(d),it)); break
    for i in bad: m[off+i:off+i+4]=d[i:i+4]
    m.flush()
else:
    print("[FAIL] DRAM still",len(bad),"bad"); sys.exit(1)
# handshake: u-boot (wg) waits for this flag before bootoctlinux -> boots the instant the image
# is in, no fixed sleep. Harmless on an env that still uses `sleep`. 0x100 < OFF, off the image.
for _ in range(20):
    m[0x100:0x104]=b"GO!!"; m.flush()
    if bytes(m[0x100:0x104])==b"GO!!": break
m.close(); os.close(fd)
PY
PUSHRC=$?
if [ "$PUSHRC" -ne 0 ]; then
  echo "[FAIL] image push aborted -- will try the PCI-console recovery"
else
  ok "Booting... (u-boot flush -> bootoctlinux)"
fi
fi   # PCIBOOT != 1

# wait for the card NIC to raise its BAR2 heartbeat (magic 0x4f435348 + card_ready=1).
# Must exceed the u-boot pre-boot sleep (120s) + Linux boot: the image is pushed into the live
# window early, but u-boot only bootoctlinux's after its sleep expires, so the card is ready
# ~140s after SBR. Block here until then so nic-up finds the card up on its first try.
wait_heartbeat() {   # $1 = seconds
  local _ v
  for _ in $(seq 1 "$1"); do
    v=$(python3 -c "import mmap,os
fd=os.open('/sys/bus/pci/devices/0000:$CARD/resource2',os.O_RDWR)   # O_RDONLY mmap -> Errno 13
m=mmap.mmap(fd,4096,mmap.MAP_SHARED)
print(1 if int.from_bytes(bytes(m[0:4]),'little')==0x4f435348 and int.from_bytes(bytes(m[8:12]),'little') else 0)
m.close();os.close(fd)" 2>/dev/null)
    [ "$v" = 1 ] && return 0
    sleep 1
  done
  return 1
}
if [ "$PUSHRC" -eq 0 ] && wait_heartbeat 165; then
  ok "Heartbeat detected -- card ready. Load NIC: sudo modprobe octnic ports=2"; exit 0
fi
# No heartbeat. A live BAR2 window does not prove u-boot is waiting for GO (it may sit at its
# prompt with an empty env or an aborted autoboot): restart the chip and type the boot command
# through u-boot's PCI console instead. Tried once.
if [ "$SOFTRST" != 1 ] && [ "$PCIBOOT" != 1 ]; then
  echo "[WARN] card did not boot -- restarting the chip and booting through the PCI console"
  setpci -s "$CARD" BASE_ADDRESS_0=$(printf '0x%08x' $(( ($(awk 'NR==1{print $1}' /sys/bus/pci/devices/0000:$CARD/resource)) & 0xffffffff | 0xc ))) \
                    BASE_ADDRESS_1=0x00000000 \
                    BASE_ADDRESS_2=$(printf '0x%08x' $(( ($(awk 'NR==3{print $1}' /sys/bus/pci/devices/0000:$CARD/resource)) & 0xffffffff | 0xc ))) \
                    BASE_ADDRESS_3=0x00000000 COMMAND=0x06
  if soft_reset_chip && sleep 3 && pci_console_boot && wait_heartbeat 160; then
    ok "Heartbeat detected (PCI-console boot) -- card ready. Load NIC: sudo modprobe octnic ports=2"; exit 0
  fi
fi
echo "[WARN] no heartbeat; card may still be booting. Check: sudo modprobe octnic"
exit 1
